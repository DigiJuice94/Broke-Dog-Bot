# === REQUIRED FOR LIVE TRADING ===
LIVE_TRADING=false
BS58_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_KEY=

# === REQUIRED FOR v8.3-STYLE SAFETY DATA ===
HELIUS_API_KEY=
BIRDEYE_API_KEY=

# === OPTIONAL DISCOVERY ===
MOBULA_API_KEY=
X_BEARER_TOKEN=

# Axiom/FOMO generic API placeholders intentionally removed.
# Add only a real supported provider integration.

# === ENTRY RULES ===
BUY_SCORE=75
ELITE_SCORE=90
FLAME_ENABLED=true
FLAME_MIN_SCORE=92
FLAME_MIN_RUNNER_SCORE=90
FLAME_MIN_CONFIDENCE=85
FLAME_MIN_SOURCES=2
FLAME_MIN_BUY_SELL_RATIO=3
FLAME_MIN_VOLUME_1M_USD=1000
FLAME_MAX_AGE_MIN=10

# === PAPER WALLET (used when LIVE_TRADING=false) ===
PAPER_START_BALANCE_USD=25
PAPER_TRACK_FEES=true
PAPER_TRACK_SLIPPAGE=true
PAPER_FEE_PCT=0.35
PAPER_SLIPPAGE_PCT=0.65
PAPER_WALLET_LOG_INTERVAL_MS=15000
PAPER_LEDGER_FILE=broke-dog-paper-ledger.json

# === POSITION / WALLET CONTROL ===
MAX_OPEN_POSITIONS=2
THIRD_POSITION_SCORE=90
MAX_POSITION_WALLET_PCT=30
THIRD_POSITION_WALLET_PCT=20
MIN_POSITION_USD=2
SOL_FEE_RESERVE=0.015
MAX_DAILY_LOSS_USD=5

# === EXITS ===
TAKE_PROFIT_PCT=30
HARD_STOP_LOSS_PCT=12
SOFT_STOP_LOSS_PCT=8
PROFIT_PROTECT_ARM_PCT=15
TRAILING_STOP_PCT=8
FLAME_TAKE_PROFIT_PCT=25
FLAME_STOP_LOSS_PCT=12
FLAME_PROFIT_PROTECT_ARM_PCT=12
FLAME_TRAILING_STOP_PCT=6
MAX_POSITION_AGE_MIN=12

# === STATE / RECONCILIATION ===
STATE_FILE=broke-dog-hybrid-state.json
RECONCILE_INTERVAL_MS=30000

# === OPTIONAL NOTIFICATIONS ===
NTFY_TOPIC=
NTFY_TOKEN=

# 🧠 Dog Brain v1 — always learning (paper + live)
DOG_BRAIN_ENABLED=true
DOG_BRAIN_FILE=broke-dog-brain-v1.json
DOG_BRAIN_MIN_SAMPLES=20
DOG_BRAIN_LEARN_RATE=0.25
DOG_BRAIN_MAX_DAILY_WEIGHT_MOVE=5
DOG_BRAIN_MAX_FEATURE_WEIGHT=5
DOG_BRAIN_MAX_SCORE_ADJUSTMENT=8
DOG_BRAIN_MAX_RECORDS=2500
DOG_BRAIN_RUNNER_PCT=25
DOG_BRAIN_RUG_PCT=40
DOG_BRAIN_REPORT_INTERVAL_MS=86400000
DOG_BRAIN_ROLLBACK_WINDOW=20
DOG_BRAIN_ROLLBACK_DROP_PCT=8
