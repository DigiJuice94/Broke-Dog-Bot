# === REQUIRED FOR LIVE TRADING ===
LIVE_TRADING=false
BS58_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_KEY=

# === REQUIRED FOR v8.3-STYLE SAFETY DATA ===
HELIUS_API_KEY=
BIRDEYE_API_KEY=

# === OPTIONAL DISCOVERY ===
MOBULA_API_KEY=
X_BEARER_TOKEN=

# Axiom/FOMO generic API placeholders intentionally removed.
# Add only a real supported provider integration.

# === DISCOVERY ROTATION ===
MAX_ACTIVE_CANDIDATES=36
FRESH_CANDIDATES_PER_CYCLE=18
STALE_EVICT_SCORE=50
STALE_EVICT_AGE_MS=90000
MOBULA_TRENDING_LIMIT=50
MOBULA_ACTIVE_SLOTS=20

# === ENTRY RULES ===
BUY_SCORE=75
ELITE_SCORE=90
FLAME_ENABLED=true
FLAME_MIN_SCORE=92
FLAME_MIN_RUNNER_SCORE=90
FLAME_MIN_CONFIDENCE=85
FLAME_MIN_SOURCES=2
FLAME_MIN_BUY_SELL_RATIO=3
FLAME_MIN_VOLUME_1M_USD=1000
FLAME_MAX_AGE_MIN=10


# === v1.4 PAPER FAST SAFETY / LEARNING MODE ===
PAPER_FAST_SAFETY=true
SAFETY_TIMEOUT_MS=3500
SAFETY_CACHE_MS=90000
SAFETY_PRECHECK_CANDIDATES=12
PAPER_MIN_OBSERVATION_MS=10000
PAPER_MIN_DATA_CONFIDENCE=60

# === PAPER WALLET (used when LIVE_TRADING=false) ===
PAPER_START_BALANCE_USD=1000
PAPER_EARLY_MAX_USD=35
PAPER_NORMAL_MAX_USD=75
PAPER_ELITE_MAX_USD=85
PAPER_FLAME_MAX_USD=100
PAPER_TRACK_FEES=true
PAPER_TRACK_SLIPPAGE=true
PAPER_FEE_PCT=0.35
PAPER_SLIPPAGE_PCT=0.65
PAPER_WALLET_LOG_INTERVAL_MS=15000
PAPER_LEDGER_FILE=broke-dog-paper-ledger.json

# === POSITION / WALLET CONTROL ===
MAX_OPEN_POSITIONS=2
THIRD_POSITION_SCORE=90
MAX_POSITION_WALLET_PCT=30
THIRD_POSITION_WALLET_PCT=20
MIN_POSITION_USD=2
SOL_FEE_RESERVE=0.015
# Separate daily loss brakes
PAPER_MAX_DAILY_LOSS_USD=50
LIVE_MAX_DAILY_LOSS_USD=50
# Legacy fallback for older deployments / live limit when LIVE_MAX_DAILY_LOSS_USD is unset
MAX_DAILY_LOSS_USD=50

# === EXITS ===
TAKE_PROFIT_PCT=30
HARD_STOP_LOSS_PCT=12
SOFT_STOP_LOSS_PCT=8
PROFIT_PROTECT_ARM_PCT=15
TRAILING_STOP_PCT=8
# v1.9 peak-profit ratchet: once peak reaches +10%, protect +2% and exit after 70% of peak gain is given back
PEAK_PROFIT_ARM_PCT=10
PEAK_PROFIT_FLOOR_PCT=2
PEAK_GIVEBACK_EXIT_PCT=70
FLAME_TAKE_PROFIT_PCT=25
FLAME_STOP_LOSS_PCT=12
FLAME_PROFIT_PROTECT_ARM_PCT=12
FLAME_TRAILING_STOP_PCT=6
MAX_POSITION_AGE_MIN=12

# === STATE / RECONCILIATION ===
STATE_FILE=broke-dog-hybrid-state.json
RECONCILE_INTERVAL_MS=30000

# === OPTIONAL NOTIFICATIONS ===
NTFY_TOPIC=
NTFY_TOKEN=


# === PERSISTENT MEMORY (recommended on Railway) ===
# Mount a Railway Volume (recommended mount path: /data).
# Railway usually exposes RAILWAY_VOLUME_MOUNT_PATH automatically; DOG_BRAIN_DATA_DIR can override it.
DOG_BRAIN_DATA_DIR=
# Leave the three *_FILE values as bare names to let the bot place them inside the persistent directory automatically.

# 🧠 Dog Brain v1 — always learning (paper + live)
DOG_BRAIN_ENABLED=true
DOG_BRAIN_FILE=broke-dog-brain-v1.json
DOG_BRAIN_MIN_SAMPLES=20
DOG_BRAIN_LEARN_RATE=0.25
DOG_BRAIN_MAX_DAILY_WEIGHT_MOVE=5
DOG_BRAIN_MAX_FEATURE_WEIGHT=5
DOG_BRAIN_MAX_SCORE_ADJUSTMENT=8
DOG_BRAIN_MAX_RECORDS=2500
DOG_BRAIN_RUNNER_PCT=25
DOG_BRAIN_RUG_PCT=40
DOG_BRAIN_REPORT_INTERVAL_MS=86400000
DOG_BRAIN_ROLLBACK_WINDOW=20
DOG_BRAIN_ROLLBACK_DROP_PCT=8

# DEX Screener protection: shared throttle/cache + automatic cooldown on 429/Cloudflare 1015
DEX_CACHE_MS=30000
DEX_DISCOVERY_INTERVAL_MS=60000
DEX_MIN_INTERVAL_MS=1200
DEX_RATE_LIMIT_BACKOFF_MS=90000


# === v1.10 FREE AI BRAIN (OpenRouter) ===
# Create a key at OpenRouter, then paste it into Railway Variables.
# The default model uses OpenRouter's free-model router. AI Brain is analysis-only and never controls trades.
AI_BRAIN_ENABLED=true
OPENROUTER_API_KEY=
AI_BRAIN_MODEL=openrouter/free
AI_BRAIN_TIMEOUT_MS=30000
AI_BRAIN_MAX_TOKENS=1200
AI_BRAIN_MAX_CHARS=8000

# === v1.5 EMAIL REPORTS (Resend) ===
EMAIL_REPORT_ENABLED=false
RESEND_API_KEY=
REPORT_EMAIL=
# Resend testing can use onboarding@resend.dev; for production use a verified sending domain/address.
REPORT_FROM=Broke Dog Bot <onboarding@resend.dev>
REPORT_INTERVAL_MINUTES=120
REPORT_TIMEZONE=America/Denver
HOURLY_PAPER_REPORT=true
HOURLY_LIVE_REPORT=true
DAILY_EMAIL_REPORT=true

# Keep routine provider 429 retry/backoff logs silent. Set true only for debugging.
RATE_LIMIT_VERBOSE=false

# AI near-buy second opinion + daily free-tier guard
AI_COIN_REVIEW_ENABLED=true
AI_COIN_MIN_SCORE=72
AI_COIN_MAX_SCORE=78
AI_COIN_MAX_PER_DAY=30
AI_TOTAL_MAX_PER_DAY=44
AI_COIN_CACHE_MINUTES=10
AI_COIN_PASS_CONFIDENCE=70
AI_COIN_PROMOTE_CONFIDENCE=90
# AI_USAGE_FILE defaults to persistent Railway volume when mounted

# v1.11.0 Dog Brain Micro-Cycle + Trade Forensics
MICRO_CYCLE_ENABLED=true
MICRO_CYCLE_MIN_SNAPSHOTS=2
MICRO_CYCLE_MAX_SCORE_ADJUSTMENT=8
MICRO_CYCLE_ANTI_FOMO_ENABLED=true
MICRO_CYCLE_LATE_ENTRY_BLOCK_RISK=82
MICRO_CYCLE_FLAME_MIN_SCORE=86
MICRO_CYCLE_FLAME_MIN_RUNNER_PROBABILITY=82
TRADE_FORENSICS_ENABLED=true
TRADE_FORENSICS_MAX_EMAIL_TRADES=12

# v1.12 AI failover (use one or more; order is Groq -> Gemini -> OpenRouter)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# v1.13.0 Autonomous Runner Brain + Memory Lock
DOG_BRAIN_AUTONOMOUS=true
DOG_BRAIN_REQUIRE_PERSISTENCE=true
# Railway: mount a persistent Volume and either rely on RAILWAY_VOLUME_MOUNT_PATH
# or set DOG_BRAIN_DATA_DIR=/data to the exact mount path.
DOG_BRAIN_AUTO_TUNE_MIN_TRADES=20
DOG_BRAIN_AUTO_TUNE_EVERY_TRADES=10
DOG_BRAIN_RUNNER_STRONG_THRESHOLD=72
DOG_BRAIN_RUNNER_MONSTER_THRESHOLD=86
DOG_BRAIN_RUNNER_MAX_TP_BONUS=55
DOG_BRAIN_RUNNER_MAX_TRAIL_BONUS=8
DOG_BRAIN_RUNNER_MAX_TIME_BONUS_MIN=18

# v1.14 quality/safety correction defaults
NORMAL_MIN_SAFETY_SCORE=80
NORMAL_MIN_SAFETY_COMPLETENESS=60
NORMAL_MIN_QUALITY_SCORE=70
NORMAL_MIN_LIQUIDITY_USD=25000
VERY_YOUNG_AGE_MIN=2
VERY_YOUNG_MIN_SAFETY_SCORE=85
VERY_YOUNG_MIN_SAFETY_COMPLETENESS=80
VERY_YOUNG_MIN_LIQUIDITY_USD=30000
YOUNG_AGE_MIN=10
YOUNG_MIN_SAFETY_SCORE=82
MIN_SCORE_ACCELERATION=-15
MAX_COLLAPSE_ACCELERATION=-35
MARKET_PRICE_DISAGREEMENT_PCT=25
ESTABLISHED_POSITION_AGE_MIN=30
POSITION_POLL_MS=2000

# v1.15 Dog Thesis defaults
THESIS_ENABLED=true
THESIS_STALK_MIN_SCORE=60
THESIS_STALK_MIN_RUNNER=60
THESIS_MAX_STALK_MINUTES=20
THESIS_MIN_ABSORPTION=55
THESIS_MAX_SUPPLY_PRESSURE=65
THESIS_MIN_BUY_SELL_RATIO=1.2
THESIS_INVALIDATION_BUY_SELL_RATIO=0.85
THESIS_VOLUME_DECAY_RATIO=0.45
THESIS_EXIT_MIN_AGE_MIN=1.5
THESIS_EXIT_FAILURE_COUNT=2

# v1.16 OMO-style intelligence / free-tier protection
MOBULA_COOLDOWN_MINUTES=15
MOBULA_MAX_COOLDOWN_MINUTES=120
INTELLIGENCE_DEGRADED_BIRDEYE_RESERVE_PCT=25
DEGRADED_MIN_THESIS_CONFIDENCE=78
CORE_MIN_THESIS_CONFIDENCE=88
CORE_MIN_ABSORPTION=70
CORE_MAX_SUPPLY_PRESSURE=45

# === v1.17 OPPORTUNITY-FIRST RUNNER ENTRY ===
# Paper mode takes small, controlled shots before a meme runner has to prove every normal gate.
# Hard high-risk flags, execution route, basic safety, liquidity and collapse protection remain mandatory.
OPPORTUNITY_FIRST_ENABLED=true
OPPORTUNITY_EARLY_PAPER_ENABLED=true
# Intentionally OFF by default until paper results prove the lane.
OPPORTUNITY_EARLY_LIVE_ENABLED=false
OPPORTUNITY_MIN_SCORE=62
OPPORTUNITY_MIN_RUNNER_SCORE=58
OPPORTUNITY_MIN_DATA_CONFIDENCE=50
OPPORTUNITY_MIN_SAFETY_SCORE=72
OPPORTUNITY_MIN_SAFETY_COMPLETENESS=45
OPPORTUNITY_MIN_QUALITY_SCORE=55
OPPORTUNITY_MIN_LIQUIDITY_USD=15000
OPPORTUNITY_MIN_BUY_SELL_RATIO=1.05
OPPORTUNITY_MIN_VOLUME_1M_USD=350
OPPORTUNITY_MIN_DEMAND_BREADTH=35
OPPORTUNITY_MAX_SUPPLY_PRESSURE=72
OPPORTUNITY_MIN_ABSORPTION=42
OPPORTUNITY_MAX_LATE_ENTRY_RISK=88
OPPORTUNITY_MAX_AGE_MIN=20
OPPORTUNITY_REQUIRE_SIGNALS=2
OPPORTUNITY_STALK_INVALIDATION_ENABLED=true
OPPORTUNITY_STALK_COOLDOWN_MINUTES=30
